{
  "name": "@quiql/lazy",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Ultra-lightweight, zero-dependency JS library for lazy loading media and on-demand external resources with request deduplication, DOM caching, and IntersectionObserver support. Engineered for Core Web Vitals and Green IT.",
  "main": "dist/quiql-lazy.js",
  "jsdelivr": "dist/quiql-lazy.min.js",
  "unpkg": "dist/quiql-lazy.min.js",
  "types": "dist/quiql-lazy.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/quiql-lazy.d.ts",
      "default": "./dist/quiql-lazy.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "quiql",
    "lazy-load",
    "lazyload",
    "intersection-observer",
    "resource-loader",
    "dynamic-script",
    "web-performance",
    "green-it"
  ],
  "author": "WebSultan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/quiql/lazy.git"
  },
  "bugs": {
    "url": "https://github.com/quiql/lazy/issues"
  },
  "homepage": "https://github.com/quiql/lazy#readme"
}
